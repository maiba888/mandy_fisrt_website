[Unit]
Description=Notify search engines about changed BeBeauty public URLs
After=network-online.target luxe-catalog.service
Wants=network-online.target

[Service]
Type=oneshot
User=luxe
Group=luxe
ExecStart=/opt/luxe-catalog/.venv/bin/python /opt/luxe-catalog/scripts/submit_indexnow.py --state-dir /var/lib/luxe-search
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/luxe-search
TimeoutStartSec=300

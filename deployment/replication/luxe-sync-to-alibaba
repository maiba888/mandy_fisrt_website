#!/usr/bin/env bash
set -Eeuo pipefail

readonly SOURCE_APP="/opt/luxe-catalog"
readonly SOURCE_DB="/var/lib/luxe-catalog/catalog.sqlite3"
readonly SOURCE_UPLOADS="/var/lib/luxe-catalog/uploads"
readonly WORK_DIR="/var/lib/luxe-replication"
readonly SNAPSHOT="${WORK_DIR}/catalog.sqlite3"
readonly REMOTE_HOST="101.132.36.115"
readonly REMOTE_USER="luxesync"
readonly REMOTE_ROOT="/var/lib/luxe-replica/incoming"
readonly SSH_KEY="/home/luxesync/.ssh/id_ed25519"
readonly KNOWN_HOSTS="/home/luxesync/.ssh/known_hosts"
readonly LOCK_FILE="/run/lock/luxe-replication.lock"

for path in "$SOURCE_APP" "$SOURCE_DB" "$SOURCE_UPLOADS"; do
    [[ -e "$path" ]] || { echo "Required source is missing: $path" >&2; exit 1; }
done
[[ "$REMOTE_ROOT" == "/var/lib/luxe-replica/incoming" ]] || exit 1

install -d -o root -g root -m 0700 "$WORK_DIR"
exec 9>"$LOCK_FILE"
flock -n 9 || { echo "Replication is already running."; exit 0; }

python3 - "$SOURCE_DB" "${SNAPSHOT}.tmp" <<'PY'
import os
import sqlite3
import sys

source_path, target_path = sys.argv[1:3]
if os.path.exists(target_path):
    os.unlink(target_path)
source = sqlite3.connect(f"file:{source_path}?mode=ro", uri=True)
target = sqlite3.connect(target_path)
with target:
    source.backup(target)
integrity = target.execute("PRAGMA integrity_check").fetchone()[0]
if integrity != "ok":
    raise SystemExit(f"SQLite snapshot failed integrity check: {integrity}")
target.close()
source.close()
PY
mv -f "${SNAPSHOT}.tmp" "$SNAPSHOT"
chmod 0600 "$SNAPSHOT"

ssh_options=(
    -i "$SSH_KEY"
    -o BatchMode=yes
    -o IdentitiesOnly=yes
    -o StrictHostKeyChecking=yes
    -o "UserKnownHostsFile=$KNOWN_HOSTS"
    -o ConnectTimeout=15
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=3
)
remote="${REMOTE_USER}@${REMOTE_HOST}"
remote_shell="ssh ${ssh_options[*]}"

ssh "${ssh_options[@]}" "$remote" \
    "mkdir -p '$REMOTE_ROOT/app' '$REMOTE_ROOT/uploads'"

rsync -a --delete-delay --partial \
    --exclude='.venv/' \
    --exclude='.git/' \
    --exclude='__pycache__/' \
    --exclude='*.pyc' \
    --exclude='catalog.sqlite3*' \
    -e "$remote_shell" \
    "$SOURCE_APP/" "$remote:$REMOTE_ROOT/app/"

rsync -a --delete-delay --partial \
    -e "$remote_shell" \
    "$SOURCE_UPLOADS/" "$remote:$REMOTE_ROOT/uploads/"

rsync -a --partial \
    -e "$remote_shell" \
    "$SNAPSHOT" "$remote:$REMOTE_ROOT/catalog.sqlite3"

ssh "${ssh_options[@]}" "$remote" "sudo /usr/local/sbin/luxe-apply-sync"
date --iso-8601=seconds > "${WORK_DIR}/last-success"
echo "Tencent-to-Alibaba replication completed at $(cat "${WORK_DIR}/last-success")."
